{
  "name": "code-explorer",
  "version": "1.0.0",
  "description": "Local-first codebase intelligence tool — visualize architecture, dependencies, and execution flow",
  "main": "dist/cli/index.js",
  "bin": {
    "code-explorer": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/cli/index.ts",
    "analyze": "ts-node src/cli/index.ts analyze",
    "serve": "ts-node src/cli/index.ts serve",
    "test": "jest --config jest.config.js",
    "lint": "eslint src/ --ext .ts",
    "build:frontend": "cd frontend && npm run build",
    "start": "ts-node src/cli/index.ts analyze && ts-node src/cli/index.ts serve"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^12.1.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "glob": "^11.0.0",
    "ignore": "^6.0.2",
    "open": "^8.4.2",
    "ora": "^5.4.1",
    "tree-sitter-java": "^0.21.0",
    "tree-sitter-javascript": "^0.21.2",
    "tree-sitter-python": "^0.21.0",
    "tree-sitter-typescript": "^0.21.1",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.24.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.5.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}
